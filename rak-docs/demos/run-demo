#!/bin/bash
# run-demo — start irak in a throwaway environment for a vhs demo recording.
# Fresh XDG folders (no init.rak, aliases or history of yours), a scratch
# working directory holding the fixtures, and atuin recording off, so the
# recording is the same on every run and nothing leaks into your history.
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$DEMO_DIR/../.." && pwd)"
TMP="$(mktemp -d -t rak-demo.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT
export XDG_CONFIG_HOME="$TMP/config" XDG_STATE_HOME="$TMP/state" \
       XDG_DATA_HOME="$TMP/data" XDG_CACHE_HOME="$TMP/cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$TMP/work"
cp -r "$DEMO_DIR/fixtures/." "$TMP/work/"
export RAKUDO_DISABLE_ATUIN=1
unset FZF_DEFAULT_OPTS
cd "$TMP/work"
"$REPO/rak" "$@"
