# Maintainer: Stéphane Payrard <cognominal at gmail dot com>
#
# rak: a Rakudo fork with a .rak frontend (naked strings, dotty subscripts,
# shellish redirection) and irak, its REPL. See rak-plans/build/AUR.md in the
# source tree for why the package looks like this.
#
# rak pins newer nqp and MoarVM than the AUR's nqp/moarvm packages, so it
# builds its own and installs the whole toolchain under /usr/lib/rak. Only
# /usr/bin/rak lands on PATH, so it coexists with rakudo, rakudo-bin, nqp
# and moarvm.

pkgname=rak-git
pkgver=2026.08.r0.g0000000
pkgrel=1
pkgdesc='Rakudo with the rak frontend: a shell-flavoured Raku, and irak, its REPL'
arch=(x86_64 aarch64)
url='https://github.com/cognominal/rak'
license=(Artistic-2.0 MIT)
depends=(glibc zstd)
makedepends=(git perl)
provides=(rak)
conflicts=(rak)
options=(!makeflags !lto)

# Raku modules for the irak line editor, installed into rak's vendor
# repository. Order matters: each one's dependencies come before it.
_dists=(
  Terminal-ANSIColor-0.14
  Terminal-ANSIParser-0.0.4
  Terminal-API-1.0.5
  Terminal-Capabilities-0.0.21
  Text-MiscUtils-0.0.13
  Terminal-LineEditor-0.0.23
)

# Every git repository Configure.pl would clone. build() redirects their
# GitHub URLs to these local mirrors, so the build itself is offline.
_repos=(
  nqp::https://github.com/Raku/nqp.git
  MoarVM::https://github.com/MoarVM/MoarVM.git
  nqp-configure::https://github.com/Raku/nqp-configure.git
  libuv::https://github.com/MoarVM/libuv.git
  dyncall::https://github.com/MoarVM/dyncall.git
  dynasm::https://github.com/MoarVM/dynasm.git
  libtommath::https://github.com/MoarVM/libtommath
  cmp::https://github.com/MoarVM/cmp.git
  libatomic_ops::https://github.com/MoarVM/libatomic_ops
  zmij::https://github.com/vitaut/zmij
  mimalloc::https://github.com/microsoft/mimalloc.git
  rapidhash::https://github.com/Nicoshev/rapidhash
)

