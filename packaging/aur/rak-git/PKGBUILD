# Point git at the local mirrors: url.<mirror>.insteadOf=<github url>.
# Configure.pl runs `git submodule sync`, which rewrites per-repo submodule
# URLs from .gitmodules, so the rewrite has to live in the environment.
_offline_git() {
  local i=0 r name url mirror
  for r in "${_repos[@]}"; do
    name=${r%%::*} url=${r#*::}
    mirror=$(git -C "$srcdir/$name" remote get-url origin)
    export "GIT_CONFIG_KEY_$i=url.$mirror.insteadOf" "GIT_CONFIG_VALUE_$i=$url"
    i=$((i + 1))
  done
  # Local mirrors use the file transport, which git blocks for submodules.
  export "GIT_CONFIG_KEY_$i=protocol.file.allow" "GIT_CONFIG_VALUE_$i=always"
  export GIT_CONFIG_COUNT=$((i + 1))
}

pkgver() {
  cd rak
  # The fork carries no tags, so use Rakudo's VERSION plus a commit count.
  printf '%s.r%s.g%s' "$(<VERSION)" "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

# The build installs the line editor itself (tools/build/rak-line-editor.pl):
# hand it the tarballs makepkg fetched so it doesn't download them.
prepare() {
  local d
  mkdir -p rak/gen/rak-dists
  for d in "${_dists[@]}"; do
    cp "$d.tar.gz" rak/gen/rak-dists/
  done
}

# --gen-moar and --gen-nqp `make install` MoarVM and nqp into the prefix at
# configure time, so the prefix can't be /usr/lib/rak, and there is no
# DESTDIR for those steps. Instead the toolchain is built relocatable (paths
# found relative to the binaries, as in rakudo.org's binary releases) and
# installed into $srcdir/root, which package() copies to /usr/lib/rak.
build() {
  _offline_git
  cd rak
  perl Configure.pl --gen-moar --gen-nqp --backends=moar --relocatable \
    --prefix="$srcdir/root"
  make
  make install   # also installs the line editor into the vendor repository
}

package() {
  install -d "$pkgdir/usr/lib"
  cp -a "$srcdir/root" "$pkgdir/usr/lib/rak"
  # The only file that records the build prefix.
  sed -i "s|$srcdir/root|/usr/lib/rak|g" "$pkgdir/usr/lib/rak/share/pkgconfig/moar.pc"

  cd rak
  install -Dm755 "$srcdir/rak.sh" "$pkgdir/usr/bin/rak"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "gen/rak-dists/Terminal-ANSIColor-0.14/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/Terminal-ANSIColor.LICENSE"
}
