use Test;

plan 5;

# rak stage | command: values become text on the command's standard input,
# YAML for structured data (rak-plans/features/pipelines.md).

my @n = <b a>;
$_ = @n;
is (.[] | ^sort), "a\nb\n", 'a list: one line per element';
$_ = 'one';
is (.[0] | ^cat), "one\n", 'a Str: one line';
$_ = 42;
is (.[0] | ^cat), "42\n", 'a number: one line';
$_ = { users => [{ name => 'ann' }, { name => 'bob' }] };
is (.users | ^cat), "- name: ann\n- name: bob\n",
  'hashes: one YAML document, a block sequence';
is (.users | ^wc -l)->trim, '2', 'a pipeline ending in a command';
